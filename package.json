{
  "name": "cocolo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.26.0",
  "engines": {
    "node": ">=24.12.0 <25"
  },
  "scripts": {
    "test": "pnpm -r --if-present test",
    "test:contracts": "node --test packages/contracts/test/*.test.ts",
    "test:unit": "node --test scripts/verify-pr-description.test.ts && vitest run && pnpm -r --if-present test:unit",
    "test:integration": "node scripts/supabase-local.ts integration",
    "test:integration:raw": "pnpm -r --workspace-concurrency=1 --if-present test:integration",
    "test:e2e:local": "node scripts/run-e2e.ts local",
    "test:e2e:staging": "node scripts/run-e2e.ts staging",
    "test:e2e:periodic": "node scripts/run-periodic-e2e.ts",
    "test:e2e:report": "node --test scripts/e2e-report.test.ts",
    "build": "pnpm -r --if-present build",
    "lint": "pnpm lint:biome && pnpm -r --if-present lint && node scripts/verify-workspace-boundaries.ts",
    "lint:biome": "biome check .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "typecheck": "tsc -p tsconfig.scripts.json --noEmit && pnpm -r --if-present typecheck",
    "generate:openapi": "node scripts/generate-openapi.ts",
    "lint:openapi": "node scripts/verify-openapi.ts",
    "test:contract": "node --test packages/contracts/test/*.test.ts",
    "test:release": "node --test scripts/release-artifact.test.ts",
    "verify:workspace-boundaries": "depcruise --config .dependency-cruiser.cjs apps packages --output-type err-long && node scripts/verify-workspace-boundaries.ts",
    "verify:migration-sql": "node scripts/verify-migration-sql.ts",
    "verify:migration-checksum": "node scripts/verify-migration-checksum.ts",
    "verify:migration-history": "node scripts/verify-migration-history.ts",
    "verify:migration-baseline": "node scripts/verify-migration-baseline.ts",
    "test:database-integrity": "node --test scripts/verify-migration-*.test.ts scripts/database-security.test.ts",
    "test:local-infrastructure": "node --test scripts/test-database-guard.test.ts",
    "verify:database-security": "node scripts/verify-database-security.ts",
    "verify:schema-drift": "node scripts/verify-schema-drift.ts",
    "verify:shadow-role": "node scripts/verify-shadow-role.ts",
    "test:schema-drift": "node --test scripts/verify-schema-drift.test.ts scripts/verify-shadow-role.test.ts scripts/database-security.test.ts scripts/deployment-preconditions.test.ts",
    "verify:pnpm-config": "node scripts/verify-pnpm-config.ts",
    "verify:pr-description": "node scripts/verify-pr-description.ts",
    "verify:database-version": "node scripts/verify-database-version.ts",
    "verify:environment": "node scripts/verify-environment.ts",
    "verify:production-bundle": "node scripts/verify-production-bundle.ts",
    "verify:release": "node scripts/verify-release.ts",
    "verify:trust-root": "node scripts/verify-trust-root.ts",
    "lint:workflows": "node scripts/verify-workflows.ts",
    "ci:fast": "node scripts/ci.ts fast",
    "ci:local": "node scripts/ci.ts local",
    "ci:staging": "node scripts/ci.ts staging",
    "create:pgpass": "node scripts/create-pgpass.ts",
    "db:prepare:test": "node scripts/db-prepare-test.ts",
    "db:seed:test": "node scripts/db-seed-test.ts",
    "dev:local": "node scripts/supabase-local.ts dev",
    "local:status": "node scripts/supabase-local.ts status",
    "local:stop": "node scripts/supabase-local.ts stop",
    "local:reset": "node scripts/supabase-local.ts reset",
    "deploy:staging": "node scripts/deploy-artifact.ts staging",
    "deploy:production": "node scripts/deploy-artifact.ts production",
    "line:schedule": "pnpm --filter @cocolo/api line:schedule",
    "package:release": "node scripts/package-release.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@playwright/test": "1.54.2",
    "@types/node": "24.3.0",
    "dependency-cruiser": "16.10.4",
    "supabase": "2.115.0",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  }
}
