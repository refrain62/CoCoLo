# 使い方: このファイルを .env にコピーし、環境に合わせて値を変更してください。
# URL、鍵、パスワードなどの実値をこのファイルへ書き込んでcommitしないでください。
# staging / productionでは、許可リストとsecretを環境ごとに設定し、local用の値を流用しないでください。

# API が起動する環境。local / staging / production のいずれかを指定します。
APP_ENV=local

# アプリケーション接続用 PostgreSQL URL。RLSを適用する cocolo_app role の接続文字列です。
DATABASE_URL=postgresql://cocolo_app:cocolo_app@localhost:5432/cocolo_local
# migration・schema検証用 PostgreSQL URL。アプリ実行用ではなく、migration ownerの接続文字列です。
DIRECT_URL=postgresql://cocolo_migration:cocolo_migration@localhost:5432/cocolo_local
# APIの待受ポート。未設定時の既定値は8787です。
PORT=8787

# Supabase プロジェクトの URL。localではSupabase CLIの既定URL、staging / productionでは各環境のURLです。
SUPABASE_URL=http://127.0.0.1:54321
# Supabase JWT公開鍵取得URL。SUPABASE_URLに対応するJWKS URLを指定します。
SUPABASE_JWKS_URL=http://127.0.0.1:54321/auth/v1/.well-known/jwks.json
# staging / productionで許可するSupabase URL。localでは空欄にします。
SUPABASE_ALLOWED_URL=
# staging / productionで許可するJWKS URL。localでは空欄にします。
SUPABASE_ALLOWED_JWKS_URL=
# ブラウザからSupabase Authを呼び出すための公開キー。秘密情報は指定しません。
SUPABASE_ANON_KEY=local-anon-key
# APIサーバー専用のSupabase Service Role Key。ブラウザへ渡さず、local以外では安全なSecret管理機能から注入します。
SUPABASE_SERVICE_ROLE_KEY=

# R2のprivate bucket名。環境ごとに local=cocolo-local / staging=cocolo-staging-private / production=cocolo-production-private 固定です。
R2_BUCKET=cocolo-local
# ブラウザからアクセスするアプリの公開URL。localはhttp://localhost:5173固定です。
PUBLIC_APP_URL=http://localhost:5173
# CORS等で許可する公開URLをカンマ区切りで指定します。staging / productionでは必須です。
PUBLIC_APP_URL_ALLOWLIST=http://localhost:5173

# productionで退部後データを保持する日数。productionでは必須、local / stagingでは空欄で構いません。
RETIRED_DATA_RETENTION_DAYS=
# productionで監査ログを保持する日数。productionでは必須、local / stagingでは空欄で構いません。
AUDIT_LOG_RETENTION_DAYS=


# Web（Vite）が参照する公開設定。SUPABASE_SERVICE_ROLE_KEYはVITE_変数に絶対に設定しません。
# localのtest-only AuthはVite proxy経由のため、通常は空欄のままにします。
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Web画面に表示する環境名。local / staging / productionを指定します。
VITE_APP_ENV=local

# staging E2Eを実行するときだけ使用します。local E2Eでは不要です。
# STAGING_BASE_URL=https://staging.example.com
# E2E_TEST_EMAIL=staging-e2e-user@example.com
# E2E_TEST_PASSWORD=staging-e2e-password

# DBをDockerコンテナ経由で準備するときだけ使用します。通常は空欄で、スクリプトが既定値を使います。
# PSQL_DOCKER_CONTAINER=
# PSQL_DOCKER_DATABASE=postgres
