# 使い方: このファイルを .env にコピーし、環境に合わせて値を変更してください。
# URL、鍵、パスワードなどの実値をこのファイルへ書き込んでcommitしないでください。
# staging / productionでは、許可リストとsecretを環境ごとに設定し、local用の値を流用しないでください。

# APIが起動する環境。local / staging / production のいずれかを指定します。
APP_ENV=local

# アプリケーション接続用PostgreSQL URL。RLSを適用するcocolo_app roleの接続文字列です。
# 次の認証情報はlocal専用の例です。本番では接続プールを利用し、実値をGitへ登録しません。
DATABASE_URL=postgresql://cocolo_app:cocolo_app@localhost:5432/cocolo_local

# migration・schema検証用PostgreSQL URL。アプリ実行用ではなくmigration ownerの接続文字列です。
# 次の認証情報はlocal専用の例です。本番ではmigration ownerの実値をGitへ登録しません。
DIRECT_URL=postgresql://cocolo_migration:cocolo_migration@localhost:5432/cocolo_local

# APIの待受ポート。未設定時の既定値は8787です。
PORT=8787

# SupabaseプロジェクトのURLです。localではSupabase CLIの既定URLを指定します。
SUPABASE_URL=http://127.0.0.1:54321

# Supabase AuthのJWT公開鍵取得URLです。SUPABASE_URLに対応するJWKS URLを指定します。
SUPABASE_JWKS_URL=http://127.0.0.1:54321/auth/v1/.well-known/jwks.json

# staging / productionで許可するSupabase URLです。localでは空欄にします。
SUPABASE_ALLOWED_URL=

# staging / productionで許可するJWKS URLです。localでは空欄にします。
SUPABASE_ALLOWED_JWKS_URL=

# ブラウザからSupabase Authを呼び出すための公開キーです。秘密情報は指定しません。
SUPABASE_ANON_KEY=local-anon-key

# APIサーバー専用のSupabase Service Role Keyです。ブラウザへ渡さず、local以外ではSecret管理機能から注入します。
SUPABASE_SERVICE_ROLE_KEY=

# R2のprivate bucket名です。環境ごとにlocal=cocolo-local / staging=cocolo-staging-private / production=cocolo-production-privateで固定します。
# APIが署名URLを発行するprivate storageとしてPhase 4で利用します。未設定の外部接続はAPIで成功扱いにしません。
R2_BUCKET=cocolo-local

# Cloudflare R2のS3互換エンドポイントです。localではテスト用stubだけを指定し、実データを置きません。
R2_ENDPOINT=http://127.0.0.1:9000

# Cloudflare R2のアクセスキーです。ブラウザへ渡さず、GitHub Environmentのsecretへ登録します。
R2_ACCESS_KEY_ID=local-r2-access-key

# Cloudflare R2の秘密キーです。ログ・artifact・配置記録へ出力しません。
R2_SECRET_ACCESS_KEY=local-r2-secret-key

# LINE Messaging APIのchannel secretです。Webhook署名検証にだけ使い、Webへ公開しません。
LINE_CHANNEL_SECRET=

# LINE Messaging APIのchannel access tokenです。Push API呼び出し専用のSecretとして管理します。
LINE_CHANNEL_ACCESS_TOKEN=

# LINE Webhookのdestinationです。別channelのpayloadを受け付けないための環境固定値です。
LINE_WEBHOOK_DESTINATION=

# LINE LIFF IDです。LIFFを利用しない場合は空欄にします。任意URLやtenant IDをstateへ設定しません。
LINE_LIFF_ID=

# LINE配信workerは外部schedulerから `pnpm line:deliver` を定期実行します。利用者向けHTTP endpointは公開しません。
# 1回のworker起動で処理するoutbox・通知queueの上限です（1〜100、未設定時は10）。
LINE_DELIVERY_BATCH_SIZE=10

# ブラウザからアクセスするアプリの公開URLです。localはhttp://localhost:5173固定です。
PUBLIC_APP_URL=http://localhost:5173

# CORS等で許可する公開URLをカンマ区切りで指定します。staging / productionでは必須です。
PUBLIC_APP_URL_ALLOWLIST=http://localhost:5173

# productionで退部後データを保持する日数。productionでは必須、local / stagingでは空欄で構いません。
RETIRED_DATA_RETENTION_DAYS=

# productionで監査ログを保持する日数。productionでは必須、local / stagingでは空欄で構いません。
AUDIT_LOG_RETENTION_DAYS=

# Web（Vite）が参照する公開設定。SUPABASE_SERVICE_ROLE_KEYはVITE_変数に絶対に設定しません。
# localのtest-only AuthはVite proxy経由のため、通常は空欄のままにします。
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Web画面に表示する環境名。local / staging / productionを指定します。
VITE_APP_ENV=local

# staging E2Eを実行するときだけ使用します。local E2Eでは不要です。
# STAGING_BASE_URL=https://staging.example.com
# E2E_TEST_EMAIL=staging-e2e-user@example.com
# E2E_TEST_PASSWORD=staging-e2e-password

# DBをDockerコンテナ経由で準備するときだけ使用します。通常は空欄で、スクリプトが既定値を使います。
# PSQL_DOCKER_CONTAINER=
# PSQL_DOCKER_DATABASE=postgres
