# 実行環境。local / staging / production のいずれかを指定します。
# staging / production ではGitHub Environment側の値を設定し、リポジトリへ秘密情報を置きません。
APP_ENV=local

# APIの通常処理が使用するDB接続文字列です。RLSが適用されるアプリ用ロールを指定します。
# 本番では接続プールを利用し、migration用の管理者接続を設定しないでください。
DATABASE_URL=postgresql://cocolo_app:cocolo_app@localhost:5432/cocolo_local

# Prisma migrationだけが使用する直接接続文字列です。アプリのリクエスト処理には渡しません。
# 本番ではmigration ownerの接続先をGitHub Environmentのsecretへ登録します。
DIRECT_URL=postgresql://cocolo_migration:cocolo_migration@localhost:5432/cocolo_local

# SupabaseプロジェクトのURLです。localではSupabase CLIのローカルURLを指定します。
SUPABASE_URL=http://127.0.0.1:54321

# Supabase AuthのJWT署名鍵取得URLです。通常はSUPABASE_URLから導出したJWKS URLを指定します。
SUPABASE_JWKS_URL=http://127.0.0.1:54321/auth/v1/.well-known/jwks.json

# staging / productionで接続を許可するSupabase URLです。localでは空欄にします。
SUPABASE_ALLOWED_URL=

# staging / productionでJWT検証に許可するJWKS URLです。環境をまたぐJWTを受け付けないために指定します。
SUPABASE_ALLOWED_JWKS_URL=

# ブラウザ側のSupabaseクライアントで使用する公開キーです。秘密鍵を設定しないでください。
SUPABASE_ANON_KEY=local-anon-key

# サーバー専用のSupabase Service Role Keyです。通常の認証・DBアクセスの代用にせず、ブラウザへ公開しません。
SUPABASE_SERVICE_ROLE_KEY=

# 添付ファイル保存先のバケット名です。Cloudflare R2導入までは予約項目で、未実装のR2機能を有効化しません。
R2_BUCKET=cocolo-local

# 利用者がアクセスするWebの公開URLです。OAuthやリダイレクトの許可先にも使うため環境ごとに分けます。
PUBLIC_APP_URL=http://localhost:5173

# CORSやリダイレクトで許可するURLをカンマ区切りで指定します。不要なオリジンを追加しません。
PUBLIC_APP_URL_ALLOWLIST=http://localhost:5173

# 退会・引退データを物理削除せず保持する日数です。未設定時の扱いは実装の環境検証に従います。
RETIRED_DATA_RETENTION_DAYS=

# 監査ログを保持する日数です。法令・契約・運用方針を確認して環境ごとに指定します。
AUDIT_LOG_RETENTION_DAYS=
