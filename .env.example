# 実行環境。local / staging / production のいずれかを指定します。
APP_ENV=local
# アプリケーション接続用 PostgreSQL URL。通常の API クエリに使用します。
DATABASE_URL=postgresql://cocolo_app:cocolo_app@localhost:5432/cocolo_local
# マイグレーション所有者用 PostgreSQL URL。マイグレーションとテスト DB の準備に使用します。
DIRECT_URL=postgresql://cocolo_migration:cocolo_migration@localhost:5432/cocolo_local
# Supabase プロジェクトの URL。local では Supabase CLI の URL を指定します。
SUPABASE_URL=http://127.0.0.1:54321
# Supabase JWT 公開鍵取得 URL。SUPABASE_URL に対応する JWKS URL を指定します。
SUPABASE_JWKS_URL=http://127.0.0.1:54321/auth/v1/.well-known/jwks.json
# staging / production で許可する Supabase URL。local では空欄にします。
SUPABASE_ALLOWED_URL=
# staging / production で許可する JWKS URL。local では空欄にします。
SUPABASE_ALLOWED_JWKS_URL=
# ブラウザから Supabase Auth を呼び出すための公開キー。秘密情報は指定しません。
SUPABASE_ANON_KEY=local-anon-key
# API サーバー専用の Supabase Service Role Key。ブラウザへ渡さず、local 以外では安全な Secret 管理機能から注入します。
SUPABASE_SERVICE_ROLE_KEY=
# 環境ごとに固定された R2 バケット名。local は cocolo-local を使用します。
R2_BUCKET=cocolo-local
# ブラウザからアクセスするアプリの公開 URL。local は http://localhost:5173 を使用します。
PUBLIC_APP_URL=http://localhost:5173
# アプリの公開 URL の許可リスト。複数指定時はカンマ区切りにします。
PUBLIC_APP_URL_ALLOWLIST=http://localhost:5173
# production で退部データを保持する日数。production 以外では空欄にします。
RETIRED_DATA_RETENTION_DAYS=
# production で監査ログを保持する日数。production 以外では空欄にします。
AUDIT_LOG_RETENTION_DAYS=
