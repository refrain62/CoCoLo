{
  "name": "@cocolo/domain",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./orders": {
      "types": "./dist/orders-domain.d.ts",
      "import": "./dist/orders-domain.js"
    },
    "./attachment": "./dist/attachment-domain.js",
    "./event": "./dist/event-domain.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test test/*.test.ts",
    "test:unit": "pnpm build && node --test test/*.test.ts",
    "lint": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit"
  },
  "devDependencies": {
    "typescript": "5.9.2"
  }
}
