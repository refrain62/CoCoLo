generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  directUrl         = env("DIRECT_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

enum Role {
  owner
  admin
  staff
  guardian

  @@map("role")
}

enum MembershipStatus {
  invited
  active
  suspended

  @@map("membership_status")
}

enum AuthProvider {
  google
  line

  @@map("auth_provider")
}

enum AuthInvitationStatus {
  pending
  accepted
  expired
  revoked

  @@map("auth_invitation_status")
}

enum MemberLinkType {
  self
  guardian

  @@map("member_link_type")
}

enum MemberLinkStatus {
  invited
  active
  revoked
  suspended

  @@map("member_link_status")
}

enum MemberCategory {
  student
  adult

  @@map("member_category")
}

enum MemberStatus {
  active
  retired
  suspended

  @@map("member_status")
}

enum PromotionRunStatus {
  preview
  completed
  failed

  @@map("promotion_run_status")
}

enum FeatureBillingType {
  free
  paid

  @@map("feature_billing_type")
}

enum TenantPlanStatus {
  active
  trialing
  past_due
  canceled
  expired

  @@map("tenant_plan_status")
}

enum FeatureFlagSource {
  default
  admin
  operator
  billing

  @@map("feature_flag_source")
}

enum EventType {
  practice
  match
  event

  @@map("event_type")
}

enum AttendanceResponse {
  attending
  absent
  pending

  @@map("attendance_response")
}

enum AttachmentStatus {
  uploaded
  available
  rejected
  deleted

  @@map("attachment_status")
}

enum AnnouncementStatus {
  published
  archived

  @@map("announcement_status")
}

enum PurchaseOrderStatus {
  open
  closed
  completed

  @@map("purchase_order_status")
}

enum PaymentStatus {
  unpaid
  paid

  @@map("payment_status")
}

enum LineConnectionStatus {
  connected
  disconnected

  @@map("line_connection_status")
}

enum LineNotificationSource {
  event
  deadline
  bulletin

  @@map("line_notification_source")
}

enum LineNotificationStatus {
  pending
  sending
  sent
  failed

  @@map("line_notification_status")
}

enum RidePlanStatus {
  draft
  open
  closed
  finalized

  @@map("ride_plan_status")
}

enum RideOfferStatus {
  open
  cancelled

  @@map("ride_offer_status")
}

enum RideRequestStatus {
  pending
  assigned
  unassigned
  cancelled

  @@map("ride_request_status")
}

model Tenant {
  id           String             @id @default(uuid(7)) @db.Uuid
  name         String             @db.VarChar(200)
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  memberships  TenantMembership[]
  members      Member[]
  guardians    GuardianMember[]
  auditLogs    AuditLog[]
  promotionRuns PromotionRun[]
  events        Event[]
  boardContacts BoardContact[]
  attachments   Attachment[]
  purchaseOrders PurchaseOrder[]
  orderProducts OrderProduct[]
  orderEntries  OrderEntry[]
  orderLines    OrderLine[]
  orderIdempotencyKeys OrderIdempotencyKey[]
  announcements Announcement[]
  lineConnections LineConnection[]
  lineNotificationQueue LineNotificationQueue[]
  lineDeliveryOutboxes LineDeliveryOutbox[]
  lineWebhookReceipts LineWebhookReceipt[]
  ridePlans     RidePlan[]
  rideOffers    RideOffer[]
  rideRequests  RideRequest[]
  rideAssignments RideAssignment[]
  authInvitations AuthInvitation[]
  plan          TenantPlan?
  featureFlags  TenantFeatureFlag[]

  @@map("tenants")
}

model FeatureDefinition {
  key           String             @id @db.VarChar(64)
  billingType   FeatureBillingType @map("billing_type")
  displayName   String             @map("display_name") @db.VarChar(200)
  defaultEnabled Boolean           @default(false) @map("default_enabled")
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime           @default(now()) @map("updated_at") @db.Timestamptz(6)
  flags         TenantFeatureFlag[]

  @@map("feature_definitions")
}

model TenantPlan {
  id                     String           @id @default(uuid(7)) @db.Uuid
  tenantId               String           @unique @map("tenant_id") @db.Uuid
  planKey                String           @map("plan_key") @db.VarChar(100)
  status                 TenantPlanStatus
  featureKeys            String[]         @map("feature_keys")
  billingProviderSubscriptionId String?   @map("billing_provider_subscription_id") @db.VarChar(256)
  startsAt               DateTime         @map("starts_at") @db.Timestamptz(6)
  endsAt                 DateTime?        @map("ends_at") @db.Timestamptz(6)
  createdAt              DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime         @default(now()) @map("updated_at") @db.Timestamptz(6)
  tenant                 Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([tenantId, id])
  @@index([tenantId, status, startsAt], map: "tenant_plans_tenant_status_starts_idx")
  @@map("tenant_plans")
}

model TenantFeatureFlag {
  tenantId     String             @map("tenant_id") @db.Uuid
  featureKey   String             @map("feature_key") @db.VarChar(64)
  enabled      Boolean
  source       FeatureFlagSource
  changedByUserId String           @map("changed_by_user_id") @db.VarChar(128)
  reason       String             @db.VarChar(500)
  startsAt     DateTime           @map("starts_at") @db.Timestamptz(6)
  endsAt       DateTime?          @map("ends_at") @db.Timestamptz(6)
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime           @default(now()) @map("updated_at") @db.Timestamptz(6)
  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  feature      FeatureDefinition  @relation(fields: [featureKey], references: [key], onDelete: Restrict, onUpdate: NoAction)

  @@id([tenantId, featureKey])
  @@index([tenantId, startsAt, endsAt], map: "tenant_feature_flags_tenant_period_idx")
  @@map("tenant_feature_flags")
}

model TenantMembership {
  id        String           @id @default(uuid(7)) @db.Uuid
  tenantId  String           @map("tenant_id") @db.Uuid
  userId    String           @map("user_id") @db.VarChar(128)
  role      Role
  status    MembershipStatus @default(active)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  boardContacts BoardContact[]

  @@unique([tenantId, userId])
  @@index([userId, status], map: "tenant_memberships_user_status_idx")
  @@map("tenant_memberships")
}

model AuthIdentity {
  id              String       @id @default(uuid(7)) @db.Uuid
  userId          String       @map("user_id") @db.VarChar(128)
  provider        AuthProvider
  providerSubject String       @map("provider_subject") @db.VarChar(256)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  revokedAt       DateTime?    @map("revoked_at") @db.Timestamptz(6)

  @@unique([provider, providerSubject])
  @@unique([userId, provider])
  @@map("auth_identities")
}

model AuthInvitation {
  id               String               @id @default(uuid(7)) @db.Uuid
  tenantId         String               @map("tenant_id") @db.Uuid
  memberId         String               @map("member_id") @db.Uuid
  role             Role
  relationship     String               @db.VarChar(100)
  tokenHash        String               @unique @map("token_hash") @db.Char(64)
  invitedByUserId  String               @map("invited_by_user_id") @db.VarChar(128)
  status           AuthInvitationStatus @default(pending)
  expiresAt        DateTime             @map("expires_at") @db.Timestamptz(6)
  acceptedAt       DateTime?            @map("accepted_at") @db.Timestamptz(6)
  acceptedByUserId String?              @map("accepted_by_user_id") @db.VarChar(128)
  revokedAt        DateTime?            @map("revoked_at") @db.Timestamptz(6)
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime             @default(now()) @map("updated_at") @db.Timestamptz(6)
  tenant           Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  member           Member               @relation(fields: [tenantId, memberId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([tenantId, id])
  @@index([tenantId, status, expiresAt], map: "auth_invitations_tenant_status_expires_idx")
  @@map("auth_invitations")
}

model Member {
  id            String           @id @default(uuid(7)) @db.Uuid
  tenantId      String           @map("tenant_id") @db.Uuid
  name          String           @db.VarChar(200)
  kana          String?          @db.VarChar(200)
  category      MemberCategory
  gradeLevel    Int?             @map("grade_level")
  ageGroup      String?          @map("age_group") @db.VarChar(100)
  status        MemberStatus     @default(active)
  note          String?
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant        Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  guardianLinks GuardianMember[]
  attendanceResponses AttendanceResponseRecord[]
  orderEntries  OrderEntry[]
  rideRequests  RideRequest[]
  invitations   AuthInvitation[]

  @@unique([tenantId, id])
  @@index([tenantId, status, category], map: "members_tenant_status_category_idx")
  @@index([tenantId, name], map: "members_tenant_name_idx")
  @@map("members")
}

model GuardianMember {
  id           String   @id @default(uuid(7)) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  userId       String   @map("user_id") @db.VarChar(128)
  memberId     String   @map("member_id") @db.Uuid
  relationship String   @db.VarChar(100)
  linkType     MemberLinkType   @default(guardian) @map("link_type")
  status       MemberLinkStatus  @default(active)
  consentedAt  DateTime? @map("consented_at") @db.Timestamptz(6)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  member       Member    @relation(fields: [tenantId, memberId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([tenantId, userId, memberId])
  @@index([tenantId, userId], map: "guardian_members_tenant_user_idx")
  @@map("guardian_members")
}

model AuditLog {
  id         String   @id @default(uuid(7)) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  actorUserId String  @map("actor_user_id") @db.VarChar(128)
  action     String   @db.VarChar(100)
  resourceType String @map("resource_type") @db.VarChar(100)
  resourceId String?  @map("resource_id") @db.Uuid
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([tenantId, createdAt], map: "audit_logs_tenant_created_idx")
  @@map("audit_logs")
}

model PromotionRun {
  id             String            @id @default(uuid(7)) @db.Uuid
  tenantId       String            @map("tenant_id") @db.Uuid
  fiscalYear     Int               @map("fiscal_year")
  status         PromotionRunStatus
  previewCount   Int               @default(0) @map("preview_count")
  executedAt     DateTime?         @map("executed_at") @db.Timestamptz(6)
  actorUserId    String            @map("actor_user_id") @db.VarChar(128)
  idempotencyKey String?           @map("idempotency_key") @db.VarChar(128)
  requestHash    String?            @map("request_hash") @db.Char(64)
  result         Json?
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant         Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([tenantId, id])
  @@unique([tenantId, fiscalYear])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, status], map: "promotion_runs_tenant_status_idx")
  @@map("promotion_runs")
}

model Event {
  id                         String   @id @default(uuid(7)) @db.Uuid
  tenantId                   String   @map("tenant_id") @db.Uuid
  title                      String   @db.VarChar(200)
  type                       EventType @map("event_type")
  startsAt                   DateTime @map("starts_at") @db.Timestamptz(6)
  endsAt                     DateTime @map("ends_at") @db.Timestamptz(6)
  location                   String?  @db.VarChar(500)
  itemsToBring               String?  @map("items_to_bring") @db.VarChar(2000)
  fee                        Int      @default(0)
  announcementImageAttachmentId String? @map("announcement_image_attachment_id") @db.Uuid
  opponent                   String?  @db.VarChar(200)
  meetingTime                DateTime? @map("meeting_time") @db.Timestamptz(6)
  transportationRequired     Boolean  @default(false) @map("transportation_required")
  attendanceDeadline         DateTime @map("attendance_deadline") @db.Timestamptz(6)
  createdByUserId            String   @map("created_by_user_id") @db.VarChar(128)
  updatedByUserId            String   @map("updated_by_user_id") @db.VarChar(128)
  createdAt                  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                  DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  tenant                     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  attachment                 Attachment? @relation("EventAnnouncementAttachment", fields: [tenantId, announcementImageAttachmentId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction, map: "events_tenant_attachment_fk")
  attendanceResponses        AttendanceResponseRecord[]

  @@unique([tenantId, id])
  @@index([tenantId, startsAt, id], map: "events_tenant_start_idx")
  @@index([tenantId, startsAt, id], map: "events_tenant_starts_idx")
  @@map("events")
}

model AttendanceResponseRecord {
  id               String   @id @default(uuid(7)) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  eventId          String   @map("event_id") @db.Uuid
  userId           String   @map("user_id") @db.VarChar(128)
  memberId         String   @map("member_id") @db.Uuid
  response         AttendanceResponse
  correctionReason String?  @map("correction_reason") @db.VarChar(500)
  respondedAt      DateTime @default(now()) @map("responded_at") @db.Timestamptz(6)
  updatedAt        DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  event            Event    @relation(fields: [tenantId, eventId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)
  member           Member   @relation(fields: [tenantId, memberId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([tenantId, id])
  @@unique([tenantId, eventId, userId, memberId])
  @@index([tenantId, eventId, memberId], map: "attendance_responses_event_idx")
  @@index([tenantId, eventId, memberId], map: "attendance_responses_event_member_idx")
  @@index([tenantId, userId, memberId], map: "attendance_responses_user_idx")
  @@index([tenantId, eventId, memberId, updatedAt(sort: Desc), id(sort: Desc)], map: "attendance_responses_event_member_updated_idx")
  @@map("attendance_responses")
}

model BoardContact {
  id                String   @id @default(uuid(7)) @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  fiscalYear        Int      @map("fiscal_year")
  roleName          String   @map("role_name") @db.VarChar(100)
  roleType          String   @map("role_type") @db.VarChar(16)
  assigneeUserId    String?  @map("assignee_user_id") @db.VarChar(128)
  lineContact       String?  @map("line_contact") @db.VarChar(200)
  phone             String?  @db.VarChar(32)
  contactPreference String   @map("contact_preference") @db.VarChar(8)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  assignee          TenantMembership? @relation(fields: [tenantId, assigneeUserId], references: [tenantId, userId], onDelete: Restrict, onUpdate: NoAction)

  @@unique([tenantId, id])
  @@unique([tenantId, fiscalYear, roleName])
  @@index([tenantId, fiscalYear], map: "board_contacts_tenant_year_idx")
  @@map("board_contacts")
}

model Attachment {
  id                  String         @id @default(uuid(7)) @db.Uuid
  tenantId            String         @map("tenant_id") @db.Uuid
  ownerUserId         String         @map("owner_user_id") @db.VarChar(128)
  objectKey           String         @map("object_key") @db.VarChar(512)
  mediaType           String         @map("media_type") @db.VarChar(100)
  byteSize            Int            @map("byte_size")
  sha256              String?        @db.Char(64)
  status              AttachmentStatus @default(uploaded)
  expiresAt           DateTime       @map("expires_at") @db.Timestamptz(6)
  completeAttempts    Int            @default(0) @map("complete_attempts") @db.SmallInt
  cleanupAttempts     Int            @default(0) @map("cleanup_attempts") @db.SmallInt
  cleanupCompletedAt  DateTime?      @map("cleanup_completed_at") @db.Timestamptz(6)
  createdAt           DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  availableAt         DateTime?      @map("available_at") @db.Timestamptz(6)
  deletedAt           DateTime?      @map("deleted_at") @db.Timestamptz(6)
  tenant              Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  eventReferences     Event[]        @relation("EventAnnouncementAttachment")
  announcementLinks   AnnouncementAttachment[]

  @@unique([tenantId, id])
  @@unique([tenantId, objectKey])
  @@index([tenantId, status, createdAt], map: "attachments_tenant_status_idx")
  @@index([tenantId, status, expiresAt], map: "attachments_tenant_status_expiry_idx")
  @@map("attachments")
}

model PurchaseOrder {
  id             String             @id @default(uuid(7)) @db.Uuid
  tenantId       String             @map("tenant_id") @db.Uuid
  title          String             @db.VarChar(200)
  deadline       DateTime @db.Timestamptz(6)
  status         PurchaseOrderStatus @default(open)
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant         Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  products       OrderProduct[]
  entries        OrderEntry[]

  @@unique([tenantId, id])
  @@index([tenantId, status, deadline], map: "purchase_orders_tenant_status_deadline_idx")
  @@map("purchase_orders")
}

model OrderProduct {
  id                 String       @id @default(uuid(7)) @db.Uuid
  tenantId           String       @map("tenant_id") @db.Uuid
  orderId            String       @map("order_id") @db.Uuid
  name               String       @db.VarChar(200)
  unitPrice          BigInt       @map("unit_price")
  imageUrl           String?      @map("image_url") @db.VarChar(2000)
  options            Json         @default("[]")
  requiresBackNumber Boolean      @default(false) @map("requires_back_number")
  requiresBackName   Boolean      @default(false) @map("requires_back_name")
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant             Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  order              PurchaseOrder @relation(fields: [tenantId, orderId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)
  lines              OrderLine[]

  @@unique([tenantId, id])
  @@index([tenantId, orderId, createdAt], map: "order_products_tenant_order_created_idx")
  @@map("order_products")
}

model OrderEntry {
  id                   String        @id @default(uuid(7)) @db.Uuid
  tenantId             String        @map("tenant_id") @db.Uuid
  orderId              String        @map("order_id") @db.Uuid
  ordererUserId        String        @map("orderer_user_id") @db.VarChar(128)
  ordererName          String        @map("orderer_name") @db.VarChar(200)
  memberId             String        @map("member_id") @db.Uuid
  totalAmount          BigInt        @default(0) @map("total_amount")
  paymentStatus        PaymentStatus @default(unpaid) @map("payment_status")
  paymentConfirmedAt   DateTime?     @map("payment_confirmed_at") @db.Timestamptz(6)
  paymentConfirmedBy   String?       @map("payment_confirmed_by") @db.VarChar(128)
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant               Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  order                PurchaseOrder @relation(fields: [tenantId, orderId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)
  member               Member        @relation(fields: [tenantId, memberId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)
  lines                OrderLine[]

  @@unique([tenantId, id])
  @@index([tenantId, orderId, paymentStatus, createdAt], map: "order_entries_tenant_order_payment_created_idx")
  @@index([tenantId, ordererUserId], map: "order_entries_tenant_orderer_idx")
  @@map("order_entries")
}

model OrderLine {
  id               String      @id @default(uuid(7)) @db.Uuid
  tenantId         String      @map("tenant_id") @db.Uuid
  orderEntryId     String      @map("order_entry_id") @db.Uuid
  productId        String      @map("product_id") @db.Uuid
  productName      String      @map("product_name") @db.VarChar(200)
  unitPrice        BigInt      @map("unit_price")
  quantity         Int
  selectedOptions  Json        @map("selected_options")
  backNumber       String?     @map("back_number") @db.VarChar(20)
  backName         String?     @map("back_name") @db.VarChar(40)
  amount           BigInt
  tenant           Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  orderEntry       OrderEntry  @relation(fields: [tenantId, orderEntryId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)
  product          OrderProduct @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([tenantId, id])
  @@index([tenantId, orderEntryId], map: "order_lines_tenant_entry_idx")
  @@index([tenantId, productId], map: "order_lines_tenant_product_idx")
  @@map("order_lines")
}

model OrderIdempotencyKey {
  id             String   @id @default(uuid(7)) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  actorUserId    String   @map("actor_user_id") @db.VarChar(128)
  idempotencyKey String   @map("idempotency_key") @db.VarChar(128)
  requestHash    String   @map("request_hash") @db.Char(64)
  resourceType   String   @map("resource_type") @db.VarChar(64)
  resourceId     String   @map("resource_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([tenantId, actorUserId, idempotencyKey])
  @@index([tenantId, resourceType, resourceId], map: "order_idempotency_keys_tenant_resource_idx")
  @@map("order_idempotency_keys")
}

model Announcement {
  id          String             @id @default(uuid(7)) @db.Uuid
  tenantId    String             @map("tenant_id") @db.Uuid
  authorUserId String            @map("author_user_id") @db.VarChar(128)
  title       String             @db.VarChar(200)
  body        String             @db.Text
  status      AnnouncementStatus @default(published)
  publishedAt DateTime           @default(now()) @map("published_at") @db.Timestamptz(6)
  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  attachments AnnouncementAttachment[]
  reads       AnnouncementRead[]

  @@unique([tenantId, id])
  @@index([tenantId, status, publishedAt(sort: Desc), id(sort: Desc)], map: "announcements_tenant_status_published_idx")
  @@map("announcements")
}

model AnnouncementAttachment {
  tenantId       String       @map("tenant_id") @db.Uuid
  announcementId String       @map("announcement_id") @db.Uuid
  attachmentId   String       @map("attachment_id") @db.Uuid
  position       Int          @db.SmallInt
  mediaType      String       @map("media_type") @db.VarChar(100)
  byteSize       Int          @map("byte_size")
  announcement   Announcement @relation(fields: [tenantId, announcementId], references: [tenantId, id], onDelete: Cascade, onUpdate: NoAction)
  attachment     Attachment   @relation(fields: [tenantId, attachmentId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction, map: "announcement_attachments_tenant_attachment_fk")

  @@id([tenantId, announcementId, attachmentId])
  @@unique([tenantId, announcementId, position])
  @@index([tenantId, announcementId, position], map: "announcement_attachments_tenant_announcement_idx")
  @@map("announcement_attachments")
}

model AnnouncementRead {
  tenantId       String       @map("tenant_id") @db.Uuid
  announcementId String       @map("announcement_id") @db.Uuid
  userId         String       @map("user_id") @db.VarChar(128)
  readAt         DateTime     @default(now()) @map("read_at") @db.Timestamptz(6)
  announcement   Announcement @relation(fields: [tenantId, announcementId], references: [tenantId, id], onDelete: Cascade, onUpdate: NoAction)

  @@id([tenantId, announcementId, userId])
  @@index([tenantId, announcementId, readAt], map: "announcement_reads_tenant_announcement_idx")
  @@index([tenantId, userId, readAt], map: "announcement_reads_tenant_user_idx")
  @@index([tenantId, userId, readAt], map: "announcement_reads_tenant_user_read_idx")
  @@map("announcement_reads")
}

model LineConnection {
  tenantId    String               @id @map("tenant_id") @db.Uuid
  groupId     String?              @map("group_id") @db.VarChar(128)
  status      LineConnectionStatus
  connectedAt DateTime?            @map("connected_at") @db.Timestamptz(6)
  updatedAt   DateTime             @default(now()) @map("updated_at") @db.Timestamptz(6)
  tenant      Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  notificationQueue LineNotificationQueue[]
  webhookReceipts LineWebhookReceipt[]

  @@unique([tenantId, groupId])
  @@map("line_connections")
}

model LineNotificationQueue {
  id                String                 @id @default(dbgenerated("app_uuidv7()")) @db.Uuid
  tenantId          String                 @map("tenant_id") @db.Uuid
  groupId           String                 @map("group_id") @db.VarChar(128)
  createdByUserId   String                 @map("created_by_user_id") @db.VarChar(128)
  sourceType        LineNotificationSource @map("source_type")
  sourceId          String                 @map("source_id") @db.VarChar(128)
  title             String                 @db.VarChar(200)
  body              String                 @db.VarChar(4000)
  deepLink          String                 @map("deep_link") @db.VarChar(2048)
  status            LineNotificationStatus @default(pending)
  attempts          Int                    @default(0)
  nextRetryAt      DateTime?              @map("next_retry_at") @db.Timestamptz(6)
  providerMessageId String?                @map("provider_message_id") @db.VarChar(256)
  lastError         String?                @map("last_error") @db.VarChar(500)
  createdAt         DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  sentAt            DateTime?              @map("sent_at") @db.Timestamptz(6)
  tenant            Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  lineConnection    LineConnection          @relation(fields: [tenantId, groupId], references: [tenantId, groupId], onDelete: Restrict, onUpdate: NoAction)

  @@unique([tenantId, id])
  @@index([status, nextRetryAt, createdAt, id], map: "line_notification_queue_due_idx")
  @@index([tenantId, groupId, status], map: "line_notification_queue_tenant_group_status_idx")
  @@map("line_notification_queue")
}

model LineWebhookReceipt {
  tenantId      String   @map("tenant_id") @db.Uuid
  groupId       String   @map("group_id") @db.VarChar(128)
  webhookEventId String  @map("webhook_event_id") @db.VarChar(128)
  receivedAt    DateTime @default(now()) @map("received_at") @db.Timestamptz(6)
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  lineConnection LineConnection @relation(fields: [tenantId, groupId], references: [tenantId, groupId], onDelete: Restrict, onUpdate: NoAction)

  @@id([groupId, webhookEventId])
  @@index([tenantId, receivedAt], map: "line_webhook_receipts_tenant_received_idx")
  @@map("line_webhook_receipts")
}

model LineDeliveryOutbox {
  id                String   @id @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  actorUserId       String   @map("actor_user_id") @db.VarChar(128)
  sourceType        String   @map("source_type") @db.VarChar(32)
  sourceId          String   @map("source_id") @db.VarChar(128)
  destination       String   @db.VarChar(128)
  title             String   @db.VarChar(200)
  body              String   @db.VarChar(4000)
  deepLink          String   @map("deep_link") @db.VarChar(2048)
  status            String   @default("pending") @db.VarChar(16)
  attempt           Int      @default(0)
  attemptToken      String?  @map("attempt_token") @db.Uuid
  leaseExpiresAt    DateTime? @map("lease_expires_at") @db.Timestamptz(6)
  nextRetryAt       DateTime? @map("next_retry_at") @db.Timestamptz(6)
  providerMessageId String?  @map("provider_message_id") @db.VarChar(256)
  lastErrorCode     String?  @map("last_error_code") @db.VarChar(32)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  sentAt            DateTime? @map("sent_at") @db.Timestamptz(6)
  idempotencyKey    String   @map("idempotency_key") @db.VarChar(128)
  payloadHash       String   @map("payload_hash") @db.Char(64)
  providerCheckedAt DateTime? @map("provider_checked_at") @db.Timestamptz(6)
  providerRetryKey  String   @default(dbgenerated("gen_random_uuid()")) @map("provider_retry_key") @db.Uuid
  connectionConnectedAt DateTime? @map("connection_connected_at") @db.Timestamptz(6)
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([tenantId, sourceType, sourceId])
  @@unique([tenantId, idempotencyKey], map: "line_delivery_outbox_idempotency_idx")
  @@index([status, nextRetryAt, createdAt, id], map: "line_delivery_outbox_due_idx")
  @@map("line_delivery_outbox")
}

model RidePlan {
  id                  String         @id @default(uuid(7)) @db.Uuid
  tenantId            String         @map("tenant_id") @db.Uuid
  title               String         @db.VarChar(200)
  departureAt         DateTime       @map("departure_at") @db.Timestamptz(6)
  pickupMapsUrl       String?        @map("pickup_maps_url") @db.VarChar(2048)
  destinationMapsUrl String?        @map("destination_maps_url") @db.VarChar(2048)
  status              RidePlanStatus @default(draft)
  createdAt           DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant              Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  offers              RideOffer[]
  requests            RideRequest[]
  assignments         RideAssignment[]

  @@unique([tenantId, id])
  @@index([tenantId, departureAt, id], map: "ride_plans_tenant_departure_idx")
  @@map("ride_plans")
}

model RideOffer {
  id            String          @id @default(uuid(7)) @db.Uuid
  tenantId      String          @map("tenant_id") @db.Uuid
  planId        String          @map("plan_id") @db.Uuid
  driverUserId  String          @map("driver_user_id") @db.VarChar(128)
  capacity      Int
  status        RideOfferStatus @default(open)
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant        Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  plan          RidePlan        @relation(fields: [tenantId, planId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)
  assignments   RideAssignment[]

  @@unique([tenantId, id])
  @@index([tenantId, planId, status, createdAt], map: "ride_offers_tenant_plan_status_created_idx")
  @@map("ride_offers")
}

model RideRequest {
  id               String            @id @default(uuid(7)) @db.Uuid
  tenantId         String            @map("tenant_id") @db.Uuid
  planId           String            @map("plan_id") @db.Uuid
  memberId         String            @map("member_id") @db.Uuid
  requesterUserId  String            @map("requester_user_id") @db.VarChar(128)
  passengerCount   Int               @map("passenger_count")
  status           RideRequestStatus @default(pending)
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  plan             RidePlan          @relation(fields: [tenantId, planId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)
  member           Member            @relation(fields: [tenantId, memberId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)
  assignments      RideAssignment[]

  @@unique([tenantId, id])
  @@index([tenantId, planId, status, createdAt], map: "ride_requests_tenant_plan_status_created_idx")
  @@index([tenantId, requesterUserId], map: "ride_requests_tenant_requester_idx")
  @@map("ride_requests")
}

model RideAssignment {
  id             String      @id @default(uuid(7)) @db.Uuid
  tenantId       String      @map("tenant_id") @db.Uuid
  planId         String      @map("plan_id") @db.Uuid
  requestId      String      @map("request_id") @db.Uuid
  offerId        String      @map("offer_id") @db.Uuid
  passengerCount Int         @map("passenger_count")
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant         Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  plan           RidePlan    @relation(fields: [tenantId, planId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)
  request        RideRequest @relation(fields: [tenantId, requestId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)
  offer          RideOffer   @relation(fields: [tenantId, offerId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([tenantId, id])
  @@unique([tenantId, requestId])
  @@index([tenantId, planId, offerId], map: "ride_assignments_tenant_plan_offer_idx")
  @@map("ride_assignments")
}
