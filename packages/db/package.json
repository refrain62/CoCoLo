{
  "name": "@cocolo/db",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/index.js",
    "./events": "./dist/event-repository.js",
    "./board-contact": "./dist/board-contact-repository.js",
    "./orders": {
      "types": "./dist/orders-repository.d.ts",
      "import": "./dist/orders-repository.js"
    },
    "./orders-persistent": {
      "types": "./dist/orders-persistent-repository.d.ts",
      "import": "./dist/orders-persistent-repository.js"
    },
    "./attachment": "./dist/attachment-repository.js",
    "./line": "./dist/line-repository.js",
    "./ride": {
      "types": "./dist/ride-repository.d.ts",
      "import": "./dist/ride-repository.js"
    },
    "./bulletin-board": "./dist/bulletin-board-repository.js",
    "./auth-team-selection": "./dist/auth-team-selection-repository.js"
  },
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.json",
    "test": "pnpm build && node --test test/*.test.ts test/*.test.mjs",
    "test:unit": "pnpm build && node --test test/*.test.ts",
    "lint": "node ../../scripts/prisma-validate.ts",
    "typecheck": "node ../../scripts/prisma-validate.ts",
    "test:integration": "prisma generate && node --test test/central-feature-rls.test.ts",
    "prisma:validate": "prisma validate",
    "migrate:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@cocolo/domain": "workspace:*",
    "@prisma/client": "6.10.0"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "prisma": "6.10.0",
    "typescript": "5.9.2"
  }
}
