{
  "name": "@cocolo/db",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/index.js",
    "./events": "./dist/event-repository.js"
  },
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.json",
    "lint": "node ../../scripts/prisma-validate.mjs",
    "typecheck": "node ../../scripts/prisma-validate.mjs",
    "prisma:validate": "prisma validate",
    "migrate:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@cocolo/domain": "workspace:*",
    "@prisma/client": "6.10.0"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "prisma": "6.10.0",
    "typescript": "5.9.2"
  }
}
