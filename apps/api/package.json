{
  "name": "@cocolo/api",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev:test": "tsx src/test-server.ts",
    "start": "node dist/server.js",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:unit": "pnpm --filter @cocolo/auth build && pnpm --filter @cocolo/db build && pnpm build && node --test test/*.test.mjs",
    "test:integration": "pnpm --filter @cocolo/db build && node --test test/integration/*.test.mjs"
  },
  "dependencies": {
    "@cocolo/auth": "workspace:*",
    "@cocolo/contracts": "workspace:*",
    "@cocolo/db": "workspace:*",
    "@cocolo/domain": "workspace:*",
    "@hono/node-server": "1.19.3",
    "hono": "4.9.7"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "tsx": "4.20.5",
    "typescript": "5.9.2"
  }
}
